MONGODB_URI=
MONGODB_DB=assetsphere

# Next-Auth v5 — required
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Superadmin
# Email of the platform superadmin (receives org approval notifications)
SUPERADMIN_EMAIL=
# Secret used to seed the first superadmin via POST /api/superadmin/seed
SEED_SECRET=

# Email (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Image uploads (Cloudinary) — optional
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
